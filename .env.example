# Core Domain Configuration
DOMAIN_NAME=example.com

# Secrets (Generate these with 'openssl rand -hex 32')
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
POSTGRES_PASSWORD=your_postgres_password_here
STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_here

# Admin Token for Vaultwarden (Generate with 'docker run --rm -it vaultwarden/server /vaultwarden hash')
VW_ADMIN_TOKEN=your_argon2_hash_here

# LLDAP Secrets
LLDAP_JWT_SECRET=random_secret
LLDAP_KEY_SEED=random_seed
LLDAP_LDAP_BASE_DN=dc=example,dc=com
LLDAP_LDAP_USER_PASS=password
LLDAP_LDAP_USER_EMAIL=admin@example.com

# Authentik Secrets (Generate with 'openssl rand -base64 50')
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here
AUTHENTIK_POSTGRES_PASSWORD=your_authentik_postgres_password_here
AUTHENTIK_BOOTSTRAP_PASSWORD=your_authentik_bootstrap_password_here
